; Generated by webserver stack — do not edit manually.
; Modify stack.toml and run 'webserver init' or 'webserver restart php' to regenerate.

[PHP]
engine = On
short_open_tag = Off
precision = 14
output_buffering = 4096
zlib.output_compression = Off
implicit_flush = Off
serialize_precision = -1
disable_functions =
disable_classes =
zend.enable_gc = On
expose_php = Off

; Error handling
display_errors = {{.PHP.DisplayErrors}}
display_startup_errors = {{.PHP.DisplayErrors}}
log_errors = On
log_errors_max_len = 1024
error_log = "{{fwd .Paths.Logs}}/php-error.log"
error_reporting = E_ALL

; Resource limits
max_execution_time = {{.Stack.PHP.MaxExecutionTime}}
max_input_time = 60
memory_limit = {{.Stack.PHP.MemoryLimit}}

; File uploads
file_uploads = On
upload_max_filesize = {{.Stack.PHP.UploadMaxFilesize}}
max_file_uploads = 20
post_max_size = {{.Stack.PHP.PostMaxSize}}

; Paths
extension_dir = "{{.PHP.ExtDir}}"
sys_temp_dir = "{{.PHP.TmpDir}}"

; Session
session.save_handler = files
session.save_path = "{{.PHP.SessionDir}}"
session.use_strict_mode = 1
session.use_cookies = 1
session.use_only_cookies = 1
session.cookie_httponly = 1
session.cookie_samesite = "Lax"
session.gc_maxlifetime = 1440

; Date
date.timezone = Asia/Bangkok

; Extensions
extension=bz2
extension=curl
extension=fileinfo
extension=gd
extension=gettext
extension=intl
extension=mbstring
extension=exif
extension=mysqli
extension=openssl
extension=pdo_mysql
extension=sodium
extension=zip

; OPcache
zend_extension=opcache
opcache.enable=1
opcache.enable_cli=0
opcache.memory_consumption=128
opcache.interned_strings_buffer=8
opcache.max_accelerated_files=10000
opcache.validate_timestamps=1
opcache.revalidate_freq=2
